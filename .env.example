# Server-only Vercel Production variables. Never prefix secrets with VITE_.
# Production is disabled unless BOTH of these are present; preview never sends.
CONTACT_ENABLED=false
CONTACT_SMTP_PASSWORD=

# Enable only after Web Analytics is enabled in the existing Vercel dashboard.
VITE_ANALYTICS_ENABLED=false
# Custom events require Vercel Pro/Enterprise. Do not upgrade a plan implicitly.
VITE_ANALYTICS_EVENTS_ENABLED=false
