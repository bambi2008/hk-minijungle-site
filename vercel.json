{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/zh-hk", "destination": "/zh-hk/index.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/zh-hk/products", "destination": "/zh-hk/products/index.html" },
    { "source": "/en/products", "destination": "/en/products/index.html" },
    { "source": "/zh-hk/products/canviva", "destination": "/zh-hk/products/canviva/index.html" },
    { "source": "/en/products/canviva", "destination": "/en/products/canviva/index.html" },
    { "source": "/zh-hk/solutions", "destination": "/zh-hk/solutions/index.html" },
    { "source": "/en/solutions", "destination": "/en/solutions/index.html" },
    { "source": "/zh-hk/solutions/workplace", "destination": "/zh-hk/solutions/workplace/index.html" },
    { "source": "/en/solutions/workplace", "destination": "/en/solutions/workplace/index.html" },
    { "source": "/zh-hk/solutions/property-fm", "destination": "/zh-hk/solutions/property-fm/index.html" },
    { "source": "/en/solutions/property-fm", "destination": "/en/solutions/property-fm/index.html" },
    { "source": "/zh-hk/solutions/hospitality-retail", "destination": "/zh-hk/solutions/hospitality-retail/index.html" },
    { "source": "/en/solutions/hospitality-retail", "destination": "/en/solutions/hospitality-retail/index.html" },
    { "source": "/zh-hk/technology/xponge", "destination": "/zh-hk/technology/xponge/index.html" },
    { "source": "/en/technology/xponge", "destination": "/en/technology/xponge/index.html" },
    { "source": "/zh-hk/technology/proof", "destination": "/zh-hk/technology/proof/index.html" },
    { "source": "/en/technology/proof", "destination": "/en/technology/proof/index.html" },
    { "source": "/zh-hk/esg", "destination": "/zh-hk/esg/index.html" },
    { "source": "/en/esg", "destination": "/en/esg/index.html" },
    { "source": "/zh-hk/journal", "destination": "/zh-hk/journal/index.html" },
    { "source": "/en/journal", "destination": "/en/journal/index.html" },
    { "source": "/zh-hk/journal/why-hk-minijungle", "destination": "/zh-hk/journal/why-hk-minijungle/index.html" },
    { "source": "/en/journal/why-hk-minijungle", "destination": "/en/journal/why-hk-minijungle/index.html" },
    { "source": "/zh-hk/journal/compact-hong-kong-workplaces", "destination": "/zh-hk/journal/compact-hong-kong-workplaces/index.html" },
    { "source": "/en/journal/compact-hong-kong-workplaces", "destination": "/en/journal/compact-hong-kong-workplaces/index.html" },
    { "source": "/zh-hk/journal/inside-xponge", "destination": "/zh-hk/journal/inside-xponge/index.html" },
    { "source": "/en/journal/inside-xponge", "destination": "/en/journal/inside-xponge/index.html" },
    { "source": "/zh-hk/journal/low-interruption-care", "destination": "/zh-hk/journal/low-interruption-care/index.html" },
    { "source": "/en/journal/low-interruption-care", "destination": "/en/journal/low-interruption-care/index.html" },
    { "source": "/zh-hk/journal/prototype-to-place", "destination": "/zh-hk/journal/prototype-to-place/index.html" },
    { "source": "/en/journal/prototype-to-place", "destination": "/en/journal/prototype-to-place/index.html" },
    { "source": "/zh-hk/journal/founding-pilot-programme", "destination": "/zh-hk/journal/founding-pilot-programme/index.html" },
    { "source": "/en/journal/founding-pilot-programme", "destination": "/en/journal/founding-pilot-programme/index.html" },
    { "source": "/zh-hk/about", "destination": "/zh-hk/about/index.html" },
    { "source": "/en/about", "destination": "/en/about/index.html" },
    { "source": "/zh-hk/contact", "destination": "/zh-hk/contact/index.html" },
    { "source": "/en/contact", "destination": "/en/contact/index.html" },
    { "source": "/zh-hk/privacy", "destination": "/zh-hk/privacy/index.html" },
    { "source": "/en/privacy", "destination": "/en/privacy/index.html" },
    { "source": "/zh-hk/terms", "destination": "/zh-hk/terms/index.html" },
    { "source": "/en/terms", "destination": "/en/terms/index.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
